{
  "id": "stickers",
  "name": "表情包（图库 / 挑选 / 收藏）",
  "version": "1.0.0",
  "engines": {
    "qqBridge": ">=0.4.0"
  },
  "configPath": "socialV2.sticker",
  "permissions": [
    "network",
    "state",
    "console:route",
    "mcp:register"
  ],
  "mcpTools": [
    "qq_list_stickers",
    "qq_send_sticker",
    "qq_collect_sticker",
    "qq_delete_sticker",
    "qq_sticker_note",
    "qq_set_sticker_remark",
    "qq_get_sticker_image"
  ],
  "console": {
    "cards": [
      "stickers"
    ],
    "routes": [
      "/api/plugins/stickers/card"
    ]
  },
  "configDocumentation": "config.reference.js"
}
